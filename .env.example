# Copy to .env and fill in. .env is git-ignored: never commit it (NFR-05).

# Password of the "cloud" MQTT user (printed by scripts/setup_broker.sh)
MQTT_PASSWORD=

# Shopify Dev Dashboard app (Settings page of the app)
SHOPIFY_SHOP=your-dev-store.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-10
# Optional: leave empty to use the store's first location
SHOPIFY_LOCATION_ID=

# true = do not call Shopify, only log (useful before the store is ready)
SHOPIFY_DRY_RUN=false

POSTGRES_PASSWORD=shelf
